{
  "version": 1,
  "plans": [],
  "exec": {
    "timeout": "30m",
    "shell": "native",
    "commands": [
      { "run": "cargo test --workspace --locked", "tier": "ran" },
      { "run": "cargo clippy --workspace --all-targets --locked -- -D warnings", "tier": "ran" }
    ]
  },
  "lanes": {
    "low":      { "checkers": ["wiring", "regressions", "claims_vs_code", "unfinished"], "desks": [] },
    "standard": { "checkers": ["wiring", "baseline_diff", "regressions", "tests_weakened", "claims_vs_code", "unfinished", "exec"], "desks": ["engineer", "qa"] },
    "high":     { "checkers": ["*", "-firstrun", "-release"], "desks": ["engineer", "qa", "security", "refuter"] },
    "release":  { "checkers": ["*"], "desks": ["*"], "bar": "zero_above_nit" }
  },
  "blast": {
    "high_if_touches": ["crates/**", "policy/**", "Cargo.toml", "Cargo.lock"],
    "release_if_touches": ["CHANGELOG.md", "release/**"]
  },
  "mutation": {
    "require_when": ["critical_logic_changed", "test_sensitivity_uncertain"],
    "never_merely_for": ["lane_label", "file_count", "release"],
    "command": "target/debug/vdt-mutation-runner",
    "success_exit_codes": [0],
    "critical_paths": ["crates/**"]
  },
  "firstrun": {
    "web": false,
    "commands": [
      { "run": "cargo build --workspace --locked" },
      { "run": "target/debug/vdt --version" }
    ]
  },
  "desks": {
    "run_proposals": false
  },
  "release": {
    "tag": "v1.0.0",
    "version": "1.0.0",
    "version_files": ["Cargo.toml"],
    "assets": ["dist/*.zip", "dist/*.tar.gz", "dist/*.AppImage", "dist/*.sha256"],
    "product": { "name": "verdict-gate", "manifest": "crates/verdict-cli/Cargo.toml", "lockfile": "Cargo.lock" },
    "readme": "README.md",
    "readme_commands": ["cargo build --workspace", "cargo test --workspace"],
    "checks": ["cargo test --workspace --locked"]
  },
  "vendors": {
    "cross_vendor_required_from_lane": "standard",
    "single_vendor": "refuse",
    "verifier_order": ["openai"],
    "providers": [
      {
        "name": "codex",
        "vendor": "openai",
        "command": "target/debug/vdt-provider-codex",
        "args": [],
        "timeout_secs": 300
      }
    ]
  },
  "gate": { "mode": "shadow", "max_sendbacks": 2, "stop_timeout": "20s" },
  "decisions_owner": "human",
  "exclude": ["generated", "vendor"]
}
