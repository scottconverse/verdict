{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Verdict",
          "informationUri": "https://github.com/scottconverse/verdict",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "release",
              "name": "release",
              "shortDescription": {
                "text": "release: what Verdict's checkers record"
              },
              "properties": {
                "tags": [
                  "verdict"
                ]
              }
            },
            {
              "id": "desk",
              "name": "desk",
              "shortDescription": {
                "text": "desk: what Verdict's checkers record"
              },
              "properties": {
                "tags": [
                  "verdict"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "release",
          "level": "error",
          "message": {
            "text": "the release candidate is not tagged v1.0.0 (tags on HEAD: none)"
          },
          "locations": [],
          "partialFingerprints": {
            "verdictFindingId": "release:tag-missing.8bdbbb74"
          },
          "properties": {
            "verdictFindingId": "release:tag-missing.8bdbbb74",
            "verdictRecord": 29,
            "verdictTier": "asset",
            "verdictSeverity": "blocker",
            "verdictStatus": "open",
            "judgment": false,
            "verdictEvidence": [
              "command `git tag --points-at HEAD (v1.0.0)`"
            ],
            "verdictFixHint": "create the tag only after the human approves the release"
          }
        },
        {
          "ruleId": "desk",
          "level": "error",
          "message": {
            "text": "The release candidate lacks the required v1.0.0 tag on HEAD."
          },
          "locations": [],
          "partialFingerprints": {
            "verdictFindingId": "desk:engineer.d3019d3b"
          },
          "properties": {
            "verdictFindingId": "desk:engineer.d3019d3b",
            "verdictRecord": 32,
            "verdictTier": "judgment",
            "verdictSeverity": "blocker",
            "verdictStatus": "open",
            "judgment": true,
            "verdictEvidence": [
              "command `ledger record 29`",
              "command `ledger record 30`"
            ],
            "verdictFixHint": "Once tagging is authorized, tag the intended release commit as v1.0.0 and rerun the release check."
          }
        },
        {
          "ruleId": "desk",
          "level": "error",
          "message": {
            "text": "Record 30 is listed as a clean release result despite recording a release blocker"
          },
          "locations": [],
          "partialFingerprints": {
            "verdictFindingId": "desk:refuter.d4e4757e"
          },
          "properties": {
            "verdictFindingId": "desk:refuter.d4e4757e",
            "verdictRecord": 46,
            "verdictTier": "judgment",
            "verdictSeverity": "blocker",
            "verdictStatus": "open",
            "judgment": true,
            "verdictEvidence": [
              "command `ledger record 29`",
              "command `ledger record 30`"
            ],
            "verdictFixHint": "Remove record 30 from the clean-result classification and retain the existing untagged-candidate blocker. Record 30 explicitly reports one finding and no tags on HEAD; passing tests and matching asset checksums do not contradict that blocker."
          }
        }
      ],
      "properties": {
        "verdictSession": "s-58be697247",
        "verdictHypotheses": 7,
        "verdictLedgerIntact": true,
        "verdictOverrides": []
      }
    }
  ]
}