{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Verdict",
          "informationUri": "https://github.com/scottconverse/verdict",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "exec",
              "name": "exec",
              "shortDescription": {
                "text": "exec: what Verdict's checkers record"
              },
              "properties": {
                "tags": [
                  "verdict"
                ]
              }
            },
            {
              "id": "firstrun",
              "name": "firstrun",
              "shortDescription": {
                "text": "firstrun: what Verdict's checkers record"
              },
              "properties": {
                "tags": [
                  "verdict"
                ]
              }
            },
            {
              "id": "release",
              "name": "release",
              "shortDescription": {
                "text": "release: what Verdict's checkers record"
              },
              "properties": {
                "tags": [
                  "verdict"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "exec",
          "level": "error",
          "message": {
            "text": "`cargo test --workspace --locked` exited with code 101 (it left processes running after it ended (they were stopped)); baseline unknown: the re-run on the baseline was not clean (it left processes running after it ended (they were stopped))"
          },
          "locations": [],
          "partialFingerprints": {
            "verdictFindingId": "exec:failed-baseline-unknown.057d6863"
          },
          "properties": {
            "verdictFindingId": "exec:failed-baseline-unknown.057d6863",
            "verdictRecord": 25,
            "verdictTier": "ran",
            "verdictSeverity": "blocker",
            "verdictStatus": "open",
            "judgment": false,
            "verdictEvidence": [
              "command `cargo test --workspace --locked`",
              "command `cargo test --workspace --locked (on a copy of the baseline)`"
            ],
            "verdictFixHint": "fix the failure; the output's last lines are in the check's detail"
          }
        },
        {
          "ruleId": "firstrun",
          "level": "error",
          "message": {
            "text": "first-run command 1 `cargo build --workspace --locked` did not pass: it exited 101"
          },
          "locations": [],
          "partialFingerprints": {
            "verdictFindingId": "firstrun:command-failed.3c60a769"
          },
          "properties": {
            "verdictFindingId": "firstrun:command-failed.3c60a769",
            "verdictRecord": 32,
            "verdictTier": "ran",
            "verdictSeverity": "blocker",
            "verdictStatus": "open",
            "judgment": false,
            "verdictEvidence": [
              "command `cargo build --workspace --locked`"
            ],
            "verdictFixHint": "make the documented first-run path work from an empty state"
          }
        },
        {
          "ruleId": "release",
          "level": "error",
          "message": {
            "text": "release check `cargo test --workspace --locked` did not pass: it left processes running after it ended (they were stopped)"
          },
          "locations": [],
          "partialFingerprints": {
            "verdictFindingId": "release:check-failed.7e035316"
          },
          "properties": {
            "verdictFindingId": "release:check-failed.7e035316",
            "verdictRecord": 34,
            "verdictTier": "ran",
            "verdictSeverity": "blocker",
            "verdictStatus": "open",
            "judgment": false,
            "verdictEvidence": [
              "command `cargo test --workspace --locked`"
            ],
            "verdictFixHint": "make the project's own release check pass"
          }
        },
        {
          "ruleId": "release",
          "level": "error",
          "message": {
            "text": "the release candidate is not tagged v1.0.0 (tags on HEAD: none)"
          },
          "locations": [],
          "partialFingerprints": {
            "verdictFindingId": "release:tag-missing.8bdbbb74"
          },
          "properties": {
            "verdictFindingId": "release:tag-missing.8bdbbb74",
            "verdictRecord": 35,
            "verdictTier": "asset",
            "verdictSeverity": "blocker",
            "verdictStatus": "open",
            "judgment": false,
            "verdictEvidence": [
              "command `git tag --points-at HEAD (v1.0.0)`"
            ],
            "verdictFixHint": "create the tag only after the human approves the release"
          }
        }
      ],
      "properties": {
        "verdictSession": "s-dc1edf6aaa",
        "verdictHypotheses": 3,
        "verdictLedgerIntact": true,
        "verdictOverrides": []
