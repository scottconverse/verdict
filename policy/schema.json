{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scottconverse/verdict/policy/schema.json",
  "title": "Verdict policy (verdict.json)",
  "description": "Global default at ~/.verdict/policy.json, project override at <repo>/verdict.json. See docs/design.md, section 'The policy file'.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "plans": {
      "description": "Files that hold the plan.",
      "type": "array",
      "items": { "type": "string" }
    },
    "exec": {
      "type": "object",
      "properties": {
        "timeout": { "$ref": "#/$defs/duration" },
        "shell": {
          "description": "The project's declared shell: native (default), cmd, pwsh, powershell, sh, bash or zsh. A named shell that cannot start is an honest failure, never a silent fallback.",
          "enum": ["native", "cmd", "pwsh", "powershell", "sh", "bash", "zsh"]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run", "tier"],
            "properties": {
              "run": { "type": "string", "minLength": 1 },
              "tier": { "$ref": "#/$defs/tier" },
              "needs": { "type": "string" },
              "browser": {
                "description": "For a browsed-tier command: the screenshot it writes and the page it loaded. Without it the command earns ran, not browsed.",
                "type": "object",
                "required": ["screenshot"],
                "properties": {
                  "screenshot": { "type": "string", "minLength": 1 },
                  "url": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "lanes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/lane" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "checkers": { "$ref": "#/$defs/selection" },
          "desks": { "$ref": "#/$defs/selection" },
          "bar": { "type": "string" }
        }
      }
    },
    "blast": {
      "type": "object",
      "properties": {
        "high_if_touches": { "$ref": "#/$defs/globs" },
        "release_if_touches": { "$ref": "#/$defs/globs" }
      }
    },
    "mutation": {
      "type": "object",
      "properties": {
        "require_when": { "type": "array", "items": { "type": "string" } },
        "never_merely_for": { "type": "array", "items": { "type": "string" } },
        "command": {
          "description": "The project's mutation runner. It must print one JSON object: {\"survivors\": [{\"file\",\"line\",\"description\"}], \"killed\": N, \"total\": N}.",
          "type": "string",
          "minLength": 1
        },
        "report": {
          "description": "A JSON report the project's runner writes, read instead of running command.",
          "type": "string",
          "minLength": 1
        },
        "timeout": { "$ref": "#/$defs/duration" },
        "critical_paths": { "$ref": "#/$defs/globs" },
        "success_exit_codes": { "type": "array", "items": { "type": "integer" } },
        "test_sensitivity_uncertain": { "type": "boolean" }
      }
    },
    "firstrun": {
      "type": "object",
      "properties": {
        "commands": {
          "description": "The documented first-run workflow, run in order. Each is a command, or an object with run and an optional needs.",
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["run"],
                "properties": {
                  "run": { "type": "string", "minLength": 1 },
                  "needs": { "type": "string" }
                }
              }
            ]
          }
        },
        "timeout": { "$ref": "#/$defs/duration" },
        "web": {
          "description": "True (default) when the first run walks a page and must be attested at the browsed tier; false for a library or CLI with no page to load.",
          "type": "boolean"
        },
        "server": {
          "description": "The server Verdict starts for the first-run walk; its url must answer before the commands run.",
          "type": "object",
          "required": ["command", "url"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "ready_timeout": { "$ref": "#/$defs/duration" }
          }
        },
        "browser": {
          "description": "The browser command whose screenshot attests the page load.",
          "type": "object",
          "required": ["command", "screenshot"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "screenshot": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "version_files": {
          "description": "Files that must state the release version (for example a manifest).",
          "$ref": "#/$defs/globs"
        },
        "assets": {
          "description": "Release artifacts: exact paths, folders, or simple globs such as dist/*.zip.",
          "$ref": "#/$defs/globs"
        },
        "asset_hashes": {
          "description": "Expected SHA-256 per asset path.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "published": {
          "description": "A saved gh-release-view-shaped JSON record of the published release's assets, compared with the candidate.",
          "type": "string",
          "minLength": 1
        },
        "product": {
          "description": "The product identity: the name its manifest states and the lockfile that must pin its version.",
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "manifest": { "type": "string" },
            "lockfile": { "type": "string" }
          }
        },
        "readme": { "type": "string", "minLength": 1 },
        "readme_commands": {
          "description": "Commands that must appear verbatim in the README.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "description": "The project's own release checks, run under the same human approval as exec.commands.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "vendors": {
      "type": "object",
      "properties": {
        "cross_vendor_required_from_lane": { "$ref": "#/$defs/lane" },
        "verifier_order": { "type": "array", "items": { "type": "string" } },
        "single_vendor": {
          "description": "Global policy only: refuse (default) or warn when no other vendor can serve a required desk. A project's verdict.json may not set it.",
          "enum": ["refuse", "warn"]
        },
        "providers": {
          "description": "Desk providers. Each is a command that reads one JSON request on stdin and writes one JSON answer on stdout.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "vendor", "command"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "vendor": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "model": { "type": "string" },
              "timeout_secs": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["shadow", "enforce"] },
        "max_sendbacks": { "type": "integer", "minimum": 0 },
        "stop_timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "desks": {
      "type": "object",
      "properties": {
        "run_proposals": {
          "description": "When true, a desk's proposal to run a configured mutation or firstrun cell is run by the core.",
          "type": "boolean"
        }
      }
    },
    "decisions_owner": { "const": "human" },
    "exclude": { "$ref": "#/$defs/globs" },
    "suite": {
      "description": "Optional suite umbrella: member repositories, their dependency-pin files and release records.",
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "dependency_files": { "type": "array", "items": { "type": "string" } },
              "product_version": { "type": "string" },
              "release_record": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "lane": { "enum": ["low", "standard", "high", "release"] },
    "tier": { "enum": ["static", "ran", "browsed", "asset", "judgment", "honest_red", "unverified"] },
    "duration": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
    "globs": { "type": "array", "items": { "type": "string" } },
    "selection": {
      "description": "Names to run. \"*\" means all; a leading \"-\" removes one.",
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
